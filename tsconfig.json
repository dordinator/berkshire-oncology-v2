{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-hub/types/**/*.ts",
    ".next-cancer/types/**/*.ts",
    ".next-build-check/types/**/*.ts",
    ".next-treatments/types/**/*.ts",
    ".next-prodcheck/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-resources/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-audit/types/**/*.ts",
    ".next-audit-resp/types/**/*.ts",
    ".next-rq7/types/**/*.ts",
    ".next-a11y-audit/types/**/*.ts",
    ".next-review/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
